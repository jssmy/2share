{
  "name": "share-to-linkedin",
  "displayName": "Share to LinkedIn",
  "description": "Comparte fragmentos de código, commits y actualizaciones técnicas directamente en LinkedIn desde VS Code.",
  "version": "0.2.0",
  "publisher": "jssmy",
  "engines": {
    "vscode": "^1.90.0"
  },
  "icon": "media/icon.png",
  "categories": [
    "Other",
    "Programming Languages",
    "Productivity"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "share-to-linkedin-view-container",
          "title": "LINKEDIN SHARE",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "share-to-linkedin-view-container": [
        {
          "id": "share-to-linkedin.sidebarView",
          "name": "Share to LinkedIn",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "share-to-linkedin.shareSelection",
        "title": "Compartir selección",
        "category": "Share to LinkedIn",
        "icon": "$(link)"
      },
      {
        "command": "share-to-linkedin.shareLastCommit",
        "title": "Compartir último commit",
        "category": "Share to LinkedIn",
        "icon": "$(git-commit)"
      },
      {
        "command": "share-to-linkedin.openComposer",
        "title": "Abrir compositor",
        "category": "Share to LinkedIn",
        "icon": "$(send)"
      },
      {
        "command": "share-to-linkedin.openSidebar",
        "title": "Abrir panel lateral",
        "category": "Share to LinkedIn",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "share-to-linkedin.openSettings",
        "title": "Abrir configuración",
        "category": "Share to LinkedIn",
        "icon": "$(settings-gear)"
      },
      {
        "command": "share-to-linkedin.help",
        "title": "Ayuda",
        "category": "Share to LinkedIn",
        "icon": "$(question)"
      }
    ],
    "keybindings": [
      {
        "command": "share-to-linkedin.shareSelection",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus"
      },
      {
        "command": "share-to-linkedin.shareLastCommit",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "share-to-linkedin.shareSelection"
        },
        {
          "command": "share-to-linkedin.shareLastCommit"
        },
        {
          "command": "share-to-linkedin.openComposer"
        },
        {
          "command": "share-to-linkedin.openSettings"
        },
        {
          "command": "share-to-linkedin.help"
        }
      ],
      "editor/context": [
        {
          "command": "share-to-linkedin.shareSelection",
          "when": "editorHasSelection",
          "group": "share@1"
        }
      ],
      "scm/title": [
        {
          "command": "share-to-linkedin.shareLastCommit",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Share to LinkedIn",
      "properties": {
        "share-to-linkedin.includeFile": {
          "type": "boolean",
          "default": true,
          "description": "Incluir nombre de archivo y rango de líneas en la publicación."
        },
        "share-to-linkedin.showLineNumbers": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar números de líneas del fragmento de código seleccionado."
        },
        "share-to-linkedin.useCodeFormat": {
          "type": "boolean",
          "default": true,
          "description": "Formatear el código con bloques Markdown o visuales en la publicación."
        },
        "share-to-linkedin.messageTemplate": {
          "type": "string",
          "default": "Comparto este código que implementé en mi proyecto. ¡Espero que sea útil! 💡",
          "description": "Plantilla por defecto para el texto de la publicación."
        },
        "share-to-linkedin.userHeadline": {
          "type": "string",
          "default": "Full Stack Developer | Angular • Laravel",
          "description": "Subtítulo o cargo profesional para mostrar en la vista previa del post."
        },
        "share-to-linkedin.aiEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Habilitar sugerencia asistida con IA mediante vscode.lm."
        },
        "share-to-linkedin.aiModelFamily": {
          "type": "string",
          "default": "gpt-4o",
          "description": "Familia de modelo de lenguaje sugerida para la IA (ej. gpt-4o, claude-3.5-sonnet)."
        },
        "share-to-linkedin.clientId": {
          "type": "string",
          "default": "",
          "description": "Client ID personalizado para la app de LinkedIn OAuth 2.0."
        },
        "share-to-linkedin.clientSecret": {
          "type": "string",
          "default": "",
          "description": "Client Secret para la app de LinkedIn OAuth 2.0."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build": "npm run compile && npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "test": "node -r ./test-setup.js --test out/test/**/*.test.js"
  },
  "dependencies": {
    "shiki": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.21.4",
    "typescript": "^5.4.5"
  }
}
